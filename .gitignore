# --- Build output ---
# target/ is regenerated by build.sh; do not commit.
# dist/ holds the committed release zip (build.sh --package) - DO commit it.
target/
build/

# --- OS cruft ---
.DS_Store
._*
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Secrets and credentials ---
# Never commit these. If you need to ship a sample, name it secrets.yaml.example
# and commit that instead of the real file.
.env
.env.*
!.env.example
secrets.yaml
secrets.json
secrets.toml
credentials
credentials.*
*.key
*.pem
*.p12
*.pfx
*.keystore
*_rsa
*_dsa
*_ecdsa
*_ed25519
id_rsa
id_dsa
id_ecdsa
id_ed25519
known_hosts
.netrc

# --- Cloud provider creds ---
.aws/
.gcp/
gcp-key.json
service-account*.json
.azure/
